# Copy this file to .env and change the values marked "change me".

# Postgres credentials for the database container in compose.yaml.
POSTGRES_USER=myvgc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=myvgc

# Postgres connection string. compose.yaml builds its own from the POSTGRES_* values
# above; this one is used by `pnpm dev` and when running the image outside Compose.
DATABASE_URL=postgres://myvgc:change-me@localhost:5432/myvgc

# Secret used to sign sessions, at least 32 characters. Change me: the app refuses to start
# with this example value. Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me

# The address people use to reach this install, exactly as typed in the browser. Log-ins only
# work from this address, and https:// addresses get secure cookies.
APP_URL=http://localhost:3000

# Set to false to refuse new sign-ups. The first account can always be created.
ALLOW_SIGNUPS=true

# Port the app listens on.
PORT=3000
