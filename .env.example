# Copy this file to .env and change the values marked "change me".

# Postgres credentials for the database container in compose.yaml.
# Change me: use letters and digits only (it goes into a connection URL), for example the
# output of `openssl rand -hex 24`.
POSTGRES_USER=myvgc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=myvgc

# Postgres connection string. compose.yaml builds its own from the POSTGRES_* values
# above; this one is used by `pnpm dev` and when running the image outside Compose.
DATABASE_URL=postgres://myvgc:change-me@localhost:5432/myvgc

# Secret used to sign sessions, at least 32 characters. Change me: the app refuses to start
# with this example value. Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me

# The address people use to reach this install, exactly as typed in the browser. Log-ins only
# work from this address, and https:// addresses get secure cookies.
APP_URL=http://localhost:3000

# Set to false to refuse new sign-ups. The first account can always be created.
ALLOW_SIGNUPS=true

# Folder for uploaded files, such as Teamsheet PDFs. The image keeps them in /data/uploads, on the
# volume compose.yaml sets up, so leave this unset there. `pnpm dev` uses .data/uploads.
# UPLOADS_DIR=/data/uploads

# Optional: read Teams from screenshots and photos with Anthropic's AI vision model. Leave the key
# empty to keep this off; the image upload is then hidden. Each read sends the images to Anthropic
# and costs money on that key's account. MyVGC doesn't keep the images.
ANTHROPIC_API_KEY=
# The model that reads the images. Leave unset for the default, claude-sonnet-5-5.
# TEAM_READER_MODEL=claude-sonnet-5-5
# Most image reads each User can make in a day. Leave unset for no limit.
# TEAM_READER_DAILY_LIMIT=20

# Port the app listens on.
PORT=3000

# Which published image to run, such as 0.1.0. Leave it as latest to get each new release
# when you run `docker compose pull`.
MYVGC_VERSION=latest
