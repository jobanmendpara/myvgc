{
  "name": "myvgc",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^24.11.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:lan": "WEB_HOST=0.0.0.0 pnpm dev",
    "preview": "node scripts/preview.ts",
    "preview:stop": "node scripts/preview.ts stop",
    "factory": "node factory/src/cli.ts",
    "screenshots": "node e2e/scripts/screenshots.ts",
    "db:up": "docker compose -f compose.yaml -f compose.dev.yaml up -d db",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:scripts",
    "typecheck:scripts": "tsc -p scripts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "vitest run --dir scripts && vitest run --dir e2e/scripts",
    "accuracy": "pnpm --filter @myvgc/api accuracy",
    "smoke": "pnpm --filter @myvgc/e2e smoke",
    "sprites:update": "pnpm --filter @myvgc/core sprites:update",
    "up:local": "docker compose -f compose.yaml -f compose.build.yaml up -d --build --wait"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
