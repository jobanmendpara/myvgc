{
  "name": "myvgc",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "db:up": "docker compose -f compose.yaml -f compose.dev.yaml up -d db",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
