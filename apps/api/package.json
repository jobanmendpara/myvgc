    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^24.19.2",
    "auth": "1.7.15",
    "drizzle-kit": "^0.31.11",
